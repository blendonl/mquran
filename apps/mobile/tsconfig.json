{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@mquran/quran-data": ["../../packages/quran-data/src"],
      "@mquran/asr-service": ["../../packages/asr-service/src"],
      "@mquran/word-matcher": ["../../packages/word-matcher/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
